---
import Base from '../layouts/Base.astro';
import { allRecipes, imagePath } from '../lib/recipes';

const recipes = allRecipes();
const tags = [...new Set(recipes.flatMap((r) => r.tags))].sort((a, b) => a.localeCompare(b, 'da'));

const index = recipes.map((r) => ({
  slug: r.slug,
  title: r.title,
  time: r.timeMin ?? '',
  yield: r.yield ?? 0,
  temp: r.tempC ?? 0,
  tags: r.tags,
  ing: r.ingredients.map((i) => i.name.toLowerCase()),
}));

const ld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Chokolademuffins-opskrifter',
  description: 'Alle opskrifter på chokolademuffins med beregnede mængder og tider.',
  url: 'https://chokolademuffin.dk/',
  isPartOf: { '@type': 'WebSite', name: 'Chokolademuffin.dk', url: 'https://chokolademuffin.dk/' },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: recipes.length,
    itemListElement: recipes.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.title,
      url: `https://chokolademuffin.dk/${r.slug}/`,
    })),
  },
};
---
<Base
  title="Chokolademuffins — 49 opskrifter med beregnede mængder"
  description={`${recipes.length} opskrifter på chokolademuffins. Omregn til dit antal forme, se hvad du kan bage med det, du har, og sammenlign mængder. Drevet af Hooah AI.`}
  jsonld={ld}
  current="index"
>
  <div class="wide" style="padding-top:34px">
    <p class="kicker">Alle opskrifter · {recipes.length} stk.</p>
    <h1>Chokolademuffins, regnet rigtigt</h1>
    <p class="lede">
      Ingen livshistorier før opskriften. Mængder i gram, tider der passer til din form, og et
      regnestykke du kan se. Alt er beregnet — ikke afprøvet i et køkken.
    </p>

    <form class="filters" role="search" onsubmit="return false">
      <div class="row2">
        <div>
          <label for="q">Søg i titel og ingredienser</label>
          <input id="q" type="search" placeholder="fx banan, oreo, nødder" autocomplete="off" />
        </div>
        <div>
          <label for="tid">Højst bagetid</label>
          <select id="tid">
            <option value="0">Alle</option>
            <option value="20">20 minutter</option>
            <option value="25">25 minutter</option>
            <option value="30">30 minutter</option>
          </select>
        </div>
      </div>
      <div>
        <label for="har">Hvad har du? (kommasepareret)</label>
        <input id="har" type="text" placeholder="mel, æg, banan" autocomplete="off" />
      </div>
      {tags.length > 0 && (
        <div>
          <label id="taglabel">Filtre</label>
          <ul class="chips" aria-labelledby="taglabel">
            {tags.map((t) => (
              <li><button type="button" data-tag={t} aria-pressed="false">{t}</button></li>
            ))}
          </ul>
        </div>
      )}
    </form>

    <p class="count" id="count" aria-live="polite">{recipes.length} opskrifter</p>

    <ul class="grid" id="grid">
      {recipes.map((r) => (
        <li class="card" data-slug={r.slug}>
          <a href={`/${r.slug}/`}>
            <img
              src={imagePath(r.slug, '1x1')}
              alt={`AI-genereret illustration: ${r.title.toLowerCase()}`}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
            />
            <div class="body">
              <h3>{r.title}</h3>
              <div class="meta">
                {r.timeMin && <span>{r.timeMin} min</span>}
                {r.yield && <span>{r.yield} stk.</span>}
                {r.tempC && <span>{r.tempC}°</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
    <p class="empty" id="empty" hidden>Ingen opskrifter matcher. Prøv færre krav.</p>
  </div>

  <script type="application/json" id="recipe-index" set:html={JSON.stringify(index)} />

  <script>
    const data = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]');
    const q = document.getElementById('q') as HTMLInputElement;
    const tid = document.getElementById('tid') as HTMLSelectElement;
    const har = document.getElementById('har') as HTMLInputElement;
    const grid = document.getElementById('grid') as HTMLUListElement;
    const count = document.getElementById('count') as HTMLElement;
    const empty = document.getElementById('empty') as HTMLElement;
    const tagButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const cards = [...grid.querySelectorAll<HTMLElement>('.card')];

    const norm = (s: string) =>
      s.toLowerCase().replace(/æ/g, 'ae').replace(/ø/g, 'oe').replace(/å/g, 'aa').trim();

    const activeTags = new Set<string>();

    function apply() {
      const term = norm(q.value);
      const max = parseInt(tid.value, 10) || 0;
      const pantry = har.value
        .split(',')
        .map((s) => norm(s))
        .filter(Boolean);

      let visible = 0;
      for (const card of cards) {
        const item: any = data.find((d: any) => d.slug === card.dataset.slug);
        let ok = true;

        if (term) {
          const hay = norm(item.title) + ' ' + item.ing.map(norm).join(' ');
          ok = hay.includes(term);
        }
        if (ok && max) {
          const t = parseInt(String(item.time ?? '').split('-').pop() || '0', 10);
          ok = t > 0 && t <= max;
        }
        if (ok && pantry.length) {
          ok = pantry.every((p) => item.ing.some((i: string) => norm(i).includes(p)));
        }
        if (ok && activeTags.size) {
          ok = [...activeTags].every((t) => item.tags.includes(t));
        }

        card.hidden = !ok;
        if (ok) visible++;
      }
      count.textContent = visible === 1 ? '1 opskrift' : `${visible} opskrifter`;
      empty.hidden = visible !== 0;
    }

    q.addEventListener('input', apply);
    tid.addEventListener('change', apply);
    har.addEventListener('input', apply);
    for (const b of tagButtons) {
      b.addEventListener('click', () => {
        const t = b.dataset.tag!;
        if (activeTags.has(t)) {
          activeTags.delete(t);
          b.setAttribute('aria-pressed', 'false');
        } else {
          activeTags.add(t);
          b.setAttribute('aria-pressed', 'true');
        }
        apply();
      });
    }
  </script>
</Base>
