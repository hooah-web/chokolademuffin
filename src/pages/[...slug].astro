---
import Base from '../layouts/Base.astro';
import { allRecipes, imagePath, related, parseAmount, formatAmount } from '../lib/recipes';

export function getStaticPaths() {
  return allRecipes().map((r) => ({ params: { slug: r.slug }, props: { recipe: r } }));
}

const { recipe } = Astro.props;
const site = 'https://chokolademuffin.dk';
const url = `${site}/${recipe.slug}/`;
const others = related(recipe, 3);

const yieldText = recipe.yield ? `${recipe.yield} muffins` : undefined;
const totalTime = recipe.timeMin
  ? `PT${String(recipe.timeMin).split('-').pop()}M`
  : undefined;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.title,
  description: recipe.intro.replace(/\s+/g, ' ').slice(0, 300),
  image: [
    `${site}${imagePath(recipe.slug, '1x1')}`,
    `${site}${imagePath(recipe.slug, '4x3')}`,
    `${site}${imagePath(recipe.slug, '16x9')}`,
  ],
  author: { '@type': 'Organization', name: 'Hooah AI', url: 'https://hooah.dk' },
  publisher: { '@type': 'Organization', name: 'Chokolademuffin.dk', url: site },
  datePublished: recipe.published,
  inLanguage: 'da-DK',
  ...(yieldText ? { recipeYield: yieldText } : {}),
  ...(totalTime ? { totalTime, cookTime: totalTime } : {}),
  recipeCategory: 'Muffins',
  keywords: ['chokolademuffins', 'muffins', ...recipe.tags].join(', '),
  recipeIngredient: recipe.ingredients.map((i) => [i.amount, i.unit, i.name].filter(Boolean).join(' ')),
  recipeInstructions: recipe.steps.map((text, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text,
    url: `${url}#trin-${i + 1}`,
  })),
};

const facts = [
  recipe.yield ? { value: String(recipe.yield), label: 'muffins' } : null,
  recipe.tempC ? { value: `${recipe.tempC}°`, label: 'bagetemperatur' } : null,
  recipe.timeMin ? { value: recipe.timeMin, label: 'minutter' } : null,
  { value: String(recipe.steps.length), label: 'trin' },
].filter(Boolean) as Array<{ value: string; label: string }>;
---
<Base
  title={`${recipe.title} — opskrift med beregnede mængder`}
  description={`${recipe.title}: ${recipe.ingredients.length} ingredienser${recipe.yield ? `, ${recipe.yield} muffins` : ''}${recipe.timeMin ? `, ${recipe.timeMin} min ved ${recipe.tempC}°` : ''}. Omregn mængderne til dit antal forme.`}
  canonical={`/${recipe.slug}/`}
  ogImage={imagePath(recipe.slug, '16x9')}
  jsonld={ld}
>
  <article class="wrap" style="padding-top:26px">
    <p class="kicker">
      <a href="/" style="color:inherit;text-decoration:none">Alle opskrifter</a> · {recipe.tags[0] ?? 'Muffins'}
    </p>
    <h1>{recipe.title}</h1>
    <p class="lede">{recipe.intro}</p>

    <figure class="recipe-hero">
      <img
        src={imagePath(recipe.slug, '16x9')}
        alt={`AI-genereret illustration af ${recipe.title.toLowerCase()}`}
        width="1200"
        height="675"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="kicker" style="margin-top:8px">
        AI-genereret illustration — ikke et foto af et bagt resultat.
      </figcaption>
    </figure>

    <div class="facts">
      {facts.map((f) => (
        <div class="fact"><b>{f.value}</b><i>{f.label}</i></div>
      ))}
    </div>

    <div class="ai-note">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#b4552f" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle><path d="M12 8h.01M11 12h1v5h1"></path>
      </svg>
      <div>
        Mængder og tider er beregnet ud fra ingrediensernes forhold og almindelige bageforhold.
        Ingen har bagt eller smagt denne opskrift for at skrive den.
      </div>
    </div>

    <h2>Ingredienser</h2>
    {recipe.equipment.length > 0 && (
      <p class="kicker" style="margin:-4px 0 14px">
        Du skal bruge: {recipe.equipment.map((e) => `${e.amount} ${e.unit} ${e.name}`.trim()).join(' · ')}
      </p>
    )}
    <div class="scaler" id="scaler">
      <span>Omregn</span>
      <button type="button" data-factor="0.5" aria-pressed="false">½ portion</button>
      <button type="button" data-factor="1" aria-pressed="true">1 portion</button>
      <button type="button" data-factor="2" aria-pressed="false">2 portioner</button>
      {recipe.yield ? (
        <>
          <span style="margin-left:8px">eller antal</span>
          <label class="hint" for="forme" style="position:absolute;left:-9999px">Antal muffins</label>
          <input id="forme" type="number" min="1" max="96" value={recipe.yield} inputmode="numeric"
            style="width:82px;font-family:var(--mono);font-size:14px;padding:6px 8px;background:var(--card);border:1px solid var(--line);border-radius:8px" />
          <span class="hint">muffins</span>
        </>
      ) : (
        <span class="hint">Opskriften angiver ikke antal — omregn i portioner.</span>
      )}
    </div>

    <ul class="ing">
      {recipe.ingredients.map((i) => {
        const n = parseAmount(i.amount);
        return (
          <li>
            <span class="nm">{i.name}</span>
            <span class="amt" data-amount={n ?? undefined} data-unit={i.unit}>{`${i.amount} ${i.unit}`.trim()}</span>
          </li>
        );
      })}
    </ul>

    <h2>Fremgangsmåde</h2>
    <ol class="steps">
      {recipe.steps.map((s, i) => (
        <li id={`trin-${i + 1}`}>{s}</li>
      ))}
    </ol>

    {recipe.tips.length > 0 && (
      <aside class="tips">
        <h2>Noter</h2>
        {recipe.tips.map((t) => <p>{t}</p>)}
      </aside>
    )}

    <h2>Læs videre</h2>
    <ul class="grid">
      {others.map((o) => (
        <li class="card">
          <a href={`/${o.slug}/`}>
            <img src={imagePath(o.slug, '1x1')} alt={`AI-genereret illustration: ${o.title.toLowerCase()}`} width="600" height="600" loading="lazy" decoding="async" />
            <div class="body">
              <h3>{o.title}</h3>
              <div class="meta">{o.timeMin && <span>{o.timeMin} min</span>}{o.yield && <span>{o.yield} stk.</span>}</div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="kicker" style="margin-top:36px">Opdateret {recipe.published} · <a href="/om-os/#metode">Om metoden</a></p>
  </article>

  <script define:vars={{ baseYield: recipe.yield ?? null }}>
    const scaler = document.getElementById('scaler');
    const rows = [...document.querySelectorAll('.ing .amt')];
    const forme = document.getElementById('forme');

    function round(n) {
      if (n >= 100) return Math.round(n / 5) * 5;
      if (n >= 10) return Math.round(n);
      return Math.round(n * 10) / 10;
    }

    function fmt(n) {
      const map = { '0.5': '½', '0.3': '⅓', '0.7': '⅔', '0.2': '¼', '0.8': '¾' };
      const whole = Math.floor(n);
      const rest = Math.round((n - whole) * 10) / 10;
      if (rest === 0) return String(whole);
      const frag = map[String(rest)];
      return frag ? (whole > 0 ? whole + frag : frag) : String(n).replace('.', ',');
    }

    function applyFactor(factor) {
      for (const el of rows) {
        const base = parseFloat(el.dataset.amount || '');
        if (Number.isNaN(base)) continue;
        const unit = el.dataset.unit || '';
        const val = round(base * factor);
        el.textContent = `${fmt(val)}${unit ? ' ' + unit : ''}`;
      }
    }

    if (scaler) {
      const buttons = [...scaler.querySelectorAll('button[data-factor]')];
      for (const b of buttons) {
        b.addEventListener('click', () => {
          for (const o of buttons) o.setAttribute('aria-pressed', 'false');
          b.setAttribute('aria-pressed', 'true');
          if (forme) forme.value = String(Math.round((baseYield || 1) * parseFloat(b.dataset.factor)));
          applyFactor(parseFloat(b.dataset.factor));
        });
      }
      if (forme) {
        forme.addEventListener('input', () => {
          const target = parseFloat(forme.value);
          if (!target || !baseYield) return;
          for (const o of buttons) o.setAttribute('aria-pressed', 'false');
          applyFactor(target / baseYield);
        });
      }
    }
  </script>
</Base>
